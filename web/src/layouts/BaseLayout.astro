---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Daily-curated topics — scraping news, job leads, scored against my skill profile.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <nav class="site-nav">
      <div class="container">
        <a href="/" class="brand"><span class="prompt">$</span> curator</a>
      </div>
    </nav>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <span>// built with astro · backend at github.com/anak/scrap</span>
      </div>
    </footer>
  </body>
</html>
