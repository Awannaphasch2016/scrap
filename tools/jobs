#!/usr/bin/env python3
"""jobs — natural-language CLI over the job-curator corpus.

Shaped like patterns/preferences/scenario: subcommand verbs, --json flag, and
LLM-routed natural-language search with a grep fallback.

Subcommands:
  search <query>        LLM-rank items in jobs.db against the query.
                        Falls back to FTS-style LIKE matching if no API key.
  ask <query>           NotebookLM-grounded Q&A across the full curated corpus.
                        Requires JOBS_NOTEBOOK_ID + notebooklm storage_state.
  top [--date Y-M-D]    Top-N items (by relevance) for a specific UTC date,
       [-n 10]          defaulting to today. Pure DB query, no LLM.
  list-days             Show every UTC date with at least one curated job,
                        with item count and best relevance score.

Database location follows job_curator.py · resolves $SCRAP_DB or $PWD/jobs.db.

Engine selection:
  - Default engine for `search`: anthropic SDK (requires ANTHROPIC_API_KEY).
  - Fallback engine: grep-like LIKE against title/content with the keyword
    union from SKILL_WEIGHTS as an OR.
  - `ask` uses notebooklm-py against JOBS_NOTEBOOK_ID.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sqlite3
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path


# --------- DB resolution ---------

def _find_db() -> Path:
    """Resolve jobs.db · SCRAP_DB env > CWD/jobs.db > script-dir/jobs.db."""
    if env := os.environ.get("SCRAP_DB"):
        return Path(env)
    cwd = Path.cwd() / "jobs.db"
    if cwd.exists():
        return cwd
    script_db = Path(__file__).resolve().parent.parent / "jobs.db"
    if script_db.exists():
        return script_db
    return cwd  # path that doesn't exist · let the caller error cleanly


def _open_db(read_only: bool = True) -> sqlite3.Connection:
    db = _find_db()
    if not db.exists():
        sys.exit(
            f"error: no jobs.db at {db}. Run `python job_curator.py` first, "
            f"or set SCRAP_DB."
        )
    uri = f"file:{db}?mode={'ro' if read_only else 'rwc'}"
    conn = sqlite3.connect(uri, uri=True)
    conn.row_factory = sqlite3.Row
    return conn


# --------- common formatters ---------

def _humanize_age(ts: float, now_ts: float) -> str:
    delta = max(0.0, now_ts - ts)
    if delta < 3600:
        return f"{int(delta / 60)}m ago"
    if delta < 86400:
        return f"{int(delta / 3600)}h ago"
    return f"{int(delta / 86400)}d ago"


def _row_to_dict(r: sqlite3.Row, source_name: str | None = None) -> dict:
    md = json.loads(r["metadata"]) if r["metadata"] else {}
    return {
        "id": r["id"],
        "source_id": r["source_id"],
        "source_name": source_name or "",
        "title": r["title"] or "",
        "url": r["url"] or "",
        "author": r["author"] or "",
        "content": (r["content"] or "")[:600],
        "published_at": r["published_at"] or 0,
        "relevance": r["relevance"] or 0.0,
        "tags": md.get("tags") or [],
        "metadata": md,
    }


def _print_item(item: dict, *, now_ts: float | None = None, score_label: str | None = None) -> None:
    score = score_label if score_label is not None else f"{item['relevance']:.1f}"
    age = _humanize_age(item["published_at"], now_ts or datetime.now(timezone.utc).timestamp())
    title = item["title"]
    print(f"[{score}] {title}")
    bits = [item["source_name"] or item["source_id"], age]
    if item["author"]:
        bits.append(f"by {item['author']}")
    if item["tags"]:
        bits.append("tags: " + ", ".join(item["tags"][:5]))
    print("  " + " · ".join(b for b in bits if b))
    if item["url"]:
        print(f"  {item['url']}")
    body = (item["content"] or "").strip().replace("\n", " ")
    if body:
        print(f"  {body[:200]}{'…' if len(body) > 200 else ''}")
    print()


# --------- jobs top ---------

def cmd_top(args: argparse.Namespace) -> int:
    conn = _open_db()
    # Default to today UTC if no --date given.
    if args.date:
        day = datetime.strptime(args.date, "%Y-%m-%d").replace(tzinfo=timezone.utc)
    else:
        day = datetime.now(timezone.utc).replace(hour=0, minute=0, second=0, microsecond=0)
    start_ts = day.timestamp()
    end_ts = (day + timedelta(days=1)).timestamp()

    rows = conn.execute(
        """SELECT i.*, s.name AS source_name
           FROM items i JOIN sources s ON s.id = i.source_id
           WHERE i.published_at >= ? AND i.published_at < ? AND i.relevance >= ?
           ORDER BY i.relevance DESC, i.published_at DESC
           LIMIT ?""",
        (start_ts, end_ts, args.min_relevance, args.n),
    ).fetchall()

    items = [_row_to_dict(r, r["source_name"]) for r in rows]
    if args.json:
        print(json.dumps({"date": day.strftime("%Y-%m-%d"), "items": items}, indent=2))
        return 0

    print(f"Top {args.n} for {day.strftime('%Y-%m-%d')} UTC "
          f"(threshold ≥ {args.min_relevance:g}, found {len(items)})")
    print()
    if not items:
        print("(no items)")
        return 0
    for it in items:
        _print_item(it)
    return 0


# --------- jobs list-days ---------

def cmd_list_days(args: argparse.Namespace) -> int:
    conn = _open_db()
    rows = conn.execute(
        """SELECT strftime('%Y-%m-%d', published_at, 'unixepoch') AS day,
                  COUNT(*) AS n,
                  MAX(relevance) AS best
           FROM items
           WHERE relevance >= ?
           GROUP BY day
           ORDER BY day DESC""",
        (args.min_relevance,),
    ).fetchall()
    if args.json:
        print(json.dumps([dict(r) for r in rows], indent=2))
        return 0
    if not rows:
        print("(no curated jobs)")
        return 0
    print(f"{'date':<12} {'count':>6} {'best':>6}")
    for r in rows:
        print(f"{r['day']:<12} {r['n']:>6} {r['best']:>6.1f}")
    return 0


# --------- jobs search ---------

def _candidate_pool(conn: sqlite3.Connection, limit: int, since_ts: float | None) -> list[dict]:
    """Pull a candidate pool (most-recent × highest-scored) for the LLM to rank."""
    params: list = []
    where = "1=1"
    if since_ts is not None:
        where = "i.published_at >= ?"
        params.append(since_ts)
    rows = conn.execute(
        f"""SELECT i.*, s.name AS source_name
            FROM items i JOIN sources s ON s.id = i.source_id
            WHERE {where}
            ORDER BY i.relevance DESC, i.published_at DESC
            LIMIT ?""",
        (*params, limit),
    ).fetchall()
    return [_row_to_dict(r, r["source_name"]) for r in rows]


def _llm_rank(query: str, candidates: list[dict], top_k: int) -> tuple[list[dict], str | None]:
    """Use Anthropic SDK to rank candidates against the query.

    Returns (ranked_items, warning_or_None).
    """
    try:
        import anthropic  # noqa: PLC0415
    except ImportError:
        return [], "anthropic SDK not installed (pip install anthropic)"
    if not os.environ.get("ANTHROPIC_API_KEY"):
        return [], "ANTHROPIC_API_KEY not set"

    # Build a compact catalog the model can index by id.
    catalog: list[dict] = []
    for c in candidates:
        catalog.append({
            "id": c["id"],
            "title": c["title"],
            "tags": c["tags"][:8],
            "source": c["source_name"] or c["source_id"],
            "content": (c["content"] or "")[:500],
            "url": c["url"],
        })

    prompt = (
        f"You are ranking job listings against a user's natural-language query.\n"
        f"User query: {query!r}\n\n"
        f"Below is a JSON array of {len(catalog)} candidate jobs (each with id, "
        f"title, tags, source, content excerpt, url). Pick the up to {top_k} that "
        f"BEST match the user's intent. Consider role, stack, location/remoteness, "
        f"and contract type as mentioned. Skip clearly off-topic ones.\n\n"
        f"Return ONLY a JSON object with this exact shape (no prose, no code fences):\n"
        f'{{"matches": [{{"id": "<id from catalog>", "reason": "<one sentence>"}}, ...]}}\n\n'
        f"Order matches best-first. If nothing matches, return {{\"matches\": []}}.\n\n"
        f"Catalog:\n{json.dumps(catalog, ensure_ascii=False)}"
    )

    client = anthropic.Anthropic()
    try:
        resp = client.messages.create(
            model="claude-haiku-4-5",
            max_tokens=2048,
            messages=[{"role": "user", "content": prompt}],
        )
    except Exception as e:
        return [], f"anthropic call failed: {e}"

    text = "".join(b.text for b in resp.content if getattr(b, "type", "") == "text").strip()
    # Defensive: model may wrap in code fence despite instructions.
    text = re.sub(r"^```(?:json)?\s*|\s*```$", "", text, flags=re.MULTILINE).strip()
    try:
        parsed = json.loads(text)
        matches = parsed.get("matches", [])
    except (json.JSONDecodeError, AttributeError):
        return [], f"could not parse LLM response: {text[:200]!r}"

    by_id = {c["id"]: c for c in candidates}
    ranked: list[dict] = []
    for m in matches:
        item = by_id.get(m.get("id"))
        if item is None:
            continue
        item = {**item, "match_reason": m.get("reason", "")}
        ranked.append(item)
    return ranked, None


def _grep_rank(query: str, conn: sqlite3.Connection, top_k: int, since_ts: float | None) -> list[dict]:
    """Tokenize the query, ANY-of-terms LIKE-match, rank by terms-matched × relevance.

    OR semantics so a 4-word query doesn't collapse to zero. Each row counts how
    many distinct terms hit anywhere in title+content+metadata, and we order
    by hits desc, then by curator relevance.
    """
    terms = [t.lower() for t in re.split(r"\s+", query.strip()) if len(t) >= 2]
    if not terms:
        return []
    # Build per-term LIKE clauses and ANY-of-terms gate; SQLite counts via SUM(CASE).
    case_sum = " + ".join(
        "(CASE WHEN (lower(i.title) LIKE ? OR lower(i.content) LIKE ? OR lower(i.metadata) LIKE ?) THEN 1 ELSE 0 END)"
        for _ in terms
    )
    where_or = " OR ".join(
        "lower(i.title) LIKE ? OR lower(i.content) LIKE ? OR lower(i.metadata) LIKE ?"
        for _ in terms
    )
    params: list = []
    for t in terms:
        wild = f"%{t}%"
        params.extend([wild, wild, wild])  # for case_sum
    for t in terms:
        wild = f"%{t}%"
        params.extend([wild, wild, wild])  # for where_or
    extra = ""
    if since_ts is not None:
        extra = " AND i.published_at >= ?"
        params.append(since_ts)
    rows = conn.execute(
        f"""SELECT i.*, s.name AS source_name, ({case_sum}) AS hits
            FROM items i JOIN sources s ON s.id = i.source_id
            WHERE ({where_or}){extra}
            ORDER BY hits DESC, i.relevance DESC, i.published_at DESC
            LIMIT ?""",
        (*params, top_k),
    ).fetchall()
    return [_row_to_dict(r, r["source_name"]) for r in rows]


def cmd_search(args: argparse.Namespace) -> int:
    if not args.query.strip():
        sys.exit("error: query required. Usage: jobs search \"<query>\"")

    conn = _open_db()
    since_ts = None
    if args.window_hours:
        since_ts = (datetime.now(timezone.utc) - timedelta(hours=args.window_hours)).timestamp()
    candidates = _candidate_pool(conn, limit=args.pool, since_ts=since_ts)
    if not candidates:
        if args.json:
            print(json.dumps({"matches": [], "mode": "empty"}))
        else:
            print("(no candidates · run job_curator first)")
        return 0

    warning: str | None = None
    mode = "anthropic"
    ranked, warn = _llm_rank(args.query, candidates, args.n)
    if warn:
        warning = warn
        mode = "grep"
        ranked = _grep_rank(args.query, conn, args.n, since_ts)

    if args.json:
        print(json.dumps({
            "query": args.query,
            "mode": mode,
            "warning": warning,
            "matches": ranked,
        }, indent=2))
        return 0

    if warning:
        print(f"(engine warning: {warning} — fell back to grep)", file=sys.stderr)
    print(f"Mode: {mode} · query: {args.query!r} · {len(ranked)} matches")
    print()
    if not ranked:
        print(f"No matches. Try `jobs list-days` or `jobs top` to inspect the corpus.")
        return 1
    for r in ranked:
        reason = r.get("match_reason")
        _print_item(r)
        if reason:
            print(f"  ↳ {reason}\n")
    return 0


# --------- jobs ask ---------

def cmd_ask(args: argparse.Namespace) -> int:
    if not args.query.strip():
        sys.exit("error: query required. Usage: jobs ask \"<question>\"")

    notebook_id = os.environ.get("JOBS_NOTEBOOK_ID")
    if not notebook_id:
        sys.exit(
            "error: JOBS_NOTEBOOK_ID not set. "
            "Create a NotebookLM notebook for jobs and set the id in Doppler "
            "(`doppler secrets set JOBS_NOTEBOOK_ID=... --project scrape --config dev`)."
        )

    try:
        import asyncio
        from notebooklm import NotebookLMClient  # type: ignore
    except ImportError:
        sys.exit("error: notebooklm-py not installed. pip install 'notebooklm-py[browser]'")

    async def _run() -> str:
        async with await NotebookLMClient.from_storage() as client:
            result = await client.chat.ask(notebook_id, args.query)
        # notebooklm-py result shape varies between versions.
        answer = getattr(result, "answer", None)
        if not answer and isinstance(result, dict):
            answer = result.get("answer") or result.get("response")
        return answer or str(result)

    try:
        answer = asyncio.run(_run())
    except Exception as e:
        sys.exit(f"error: NotebookLM query failed: {e}")

    if args.json:
        print(json.dumps({"query": args.query, "answer": answer}, indent=2))
    else:
        print(answer)
    return 0


# --------- argparse ---------

def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        prog="jobs",
        description="Natural-language CLI over the job-curator corpus.",
    )
    p.add_argument("--json", action="store_true", help="Output JSON instead of text.")
    sub = p.add_subparsers(dest="command", required=True)

    s = sub.add_parser("search", help="LLM-rank curated jobs against a natural-language query.")
    s.add_argument("query")
    s.add_argument("-n", type=int, default=10, help="Top-K results (default 10).")
    s.add_argument("--pool", type=int, default=80,
                   help="Candidate pool size sent to the ranker (default 80).")
    s.add_argument("--window-hours", type=int, default=None,
                   help="Restrict to items posted within this window.")
    s.set_defaults(func=cmd_search)

    a = sub.add_parser("ask", help="NotebookLM-grounded Q&A across the curated corpus.")
    a.add_argument("query")
    a.set_defaults(func=cmd_ask)

    t = sub.add_parser("top", help="Top-N for a specific UTC date (default today).")
    t.add_argument("--date", help="UTC date YYYY-MM-DD (default: today).")
    t.add_argument("-n", type=int, default=10)
    t.add_argument("--min-relevance", type=float, default=1.0)
    t.set_defaults(func=cmd_top)

    l = sub.add_parser("list-days", help="UTC dates with at least one curated job.")
    l.add_argument("--min-relevance", type=float, default=0.0)
    l.set_defaults(func=cmd_list_days)

    args = p.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
